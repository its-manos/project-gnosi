{
  "name": "project-gnosi",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.19",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.cjs",
    "beta:check": "node scripts/check-beta-build.cjs",
    "beta:check:config": "node scripts/check-beta-build.cjs --config-only",
    "beta:android": "npx eas-cli@latest build --platform android --profile preview",
    "beta:ios": "npx eas-cli@latest build --platform ios --profile beta",
    "eas-build-post-install": "node scripts/check-beta-build.cjs --remote",
    "beta:updates:setup": "node scripts/configure-beta-updates.cjs",
    "beta:update:android": "npx eas-cli@latest update --channel preview --platform android --environment preview",
    "beta:update:ios": "npx eas-cli@latest update --channel beta --platform ios --environment preview"
  },
  "private": true
}
